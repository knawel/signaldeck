; Lab 7: I2S out to the PCM5102A. One frame = 64 BCK periods: 32 for the left slot, 32 for the right.
;
; Pins (the C side sets them up in i2s_init()):
;   out pins       → DIN    1 pin, I2S_DIN_PIN
;   side-set bit 0 → BCK    I2S_BCK_PIN
;   side-set bit 1 → LRCK   I2S_BCK_PIN + 1 (side-set pins are always next to each other)
;
; `side 0bLB` sets LRCK (L) and BCK (B) in the same cycle as the instruction runs.
; Two instructions per bit:
;   1st, BCK = 0: DIN changes (`out pins, 1`)
;   2nd, BCK = 1: the DAC reads DIN on this rising edge (the instruction does the counting)
; LRCK = 0 is the left channel, 1 is the right. In I2S, LRCK changes ONE bit early:
; the last bit (LSB) of each slot goes out with LRCK already showing the next channel.
;
; The C side also sets: shift left (MSB first), autopull every 32 bits.

.program i2s_out
.side_set 2

; TODO 1: fill in the side-set values (0b00 … 0b11) and the two loop counts.
;         Draw the frame first (labbook2, task 7.3). `jmp x-- label` jumps while x was
;         not 0 before it counted down, so a loop that starts with x = n runs n + 1 times.
.wrap_target
    set x, 0            side 0b00   ; BCK high: DAC reads the right LSB. LRCK: left from now on
left_bits:
    out pins, 1         side 0b00   ; BCK low: next left bit onto DIN
    jmp x-- left_bits   side 0b00   ; BCK high: DAC reads it
    out pins, 1         side 0b00   ; BCK low: the left LSB, but LRCK already says right
    set x, 0            side 0b00   ; BCK high: DAC reads the left LSB
right_bits:
    out pins, 1         side 0b00   ; BCK low: next right bit onto DIN
    jmp x-- right_bits  side 0b00   ; BCK high: DAC reads it
    out pins, 1         side 0b00   ; BCK low: the right LSB, but LRCK already says left
.wrap
